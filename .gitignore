*.aab

# Store channel build output (scripts/store-channel.js)
/dist/

# OpenVPN sources: pinned by URL + SHA-256 in source-lock.json, fetched by the scripts
third_party/openvpn3/*
!third_party/openvpn3/README.md
!third_party/openvpn3/source-lock.json

# Team repo (25 Oct 2026, team/README.fa.md): tool state, the code graph and crash dumps stay on each PC
graphify-out/
.omc/
**/.omc/
.kotlin/
.claude/
hs_err_pid*.log
replay_pid*.log

# Gereh core (mlm-chat/): build output stays on each PC; the prebuilt libmlmchat.so in
# mlm-chat/android/core/src/main/jniLibs is kept, so the app builds without Rust
mlm-chat/**/target/
mlm-chat/**/target-*/
mlm-chat/tools/*/out/
mlm-chat/**/node_modules/
