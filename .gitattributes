# Native libraries and large data files tracked with Git LFS.
*.so filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
*.aab filter=lfs diff=lfs merge=lfs -text

# The CI signing keystore is binary: byte-exact, or every build would sign with
# a different key and in-app updates between CI builds would be rejected.
ci/*.keystore -text

# Signed test fixtures: byte-exact, or their signatures stop verifying.
app/src/test/resources/geph/* -text

# The studio worker bundle is verified byte-for-byte against its fragments
# (`node scripts/build-studio-worker.js --check`, wired into preBuild), so the
# asset and the fragments must share one line ending IN THE REPO. The asset was
# once committed with CRLF while the fragments are LF, which made the check fail
# on every Linux checkout (CI included) and pass only on Windows where
# core.autocrlf=true masks it. eol=lf pins LF everywhere.
app/src/main/assets/mlm_worker.js text eol=lf
worker-src/studio/*.js text eol=lf
worker-src/studio/*.json text eol=lf
worker-src/studio/*.sql text eol=lf
