<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_node_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingVertical="14dp">

        <!-- Active/Connected Indicator Strip -->
        <View
            android:id="@+id/indicator_active"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:background="@color/gs_primary"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Leading Icon / Avatar area -->
        <LinearLayout
            android:id="@+id/icon_area"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:background="@drawable/node_icon_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/indicator_active">

            <TextView
                android:id="@+id/tv_node_initial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N"
                android:textColor="@color/gs_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Node Name (Top Left) -->
        <TextView
            android:id="@+id/tv_node_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="US-Node-1"
            android:textColor="@color/gs_on_surface"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="@id/icon_area"
            app:layout_constraintStart_toEndOf="@id/icon_area"
            app:layout_constraintEnd_toStartOf="@id/ll_actions"/>

        <!-- Address Subtitle -->
        <TextView
            android:id="@+id/tv_node_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="443 : 192.168.1.1"
            android:textColor="@color/gs_on_surface_dim"
            android:textSize="12sp"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/tv_node_name"
            app:layout_constraintStart_toStartOf="@id/tv_node_name"
            app:layout_constraintEnd_toStartOf="@id/ll_actions"/>

        <!-- Action Icons (Right side) -->
        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ll_bottom_right">

            <ImageView
                android:id="@+id/btn_share"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_share"
                app:tint="@color/gs_on_surface_dim"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"/>

            <ImageView
                android:id="@+id/btn_edit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/gs_on_surface_dim"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"/>

            <ImageView
                android:id="@+id/btn_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/gs_error"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"/>
        </LinearLayout>

        <!-- Ping & Protocol chips (Bottom Right) -->
        <LinearLayout
            android:id="@+id/ll_bottom_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/ll_actions"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="145ms"
                android:textColor="@color/gs_secondary"
                android:textSize="11sp"
                android:background="@drawable/chip_bg_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tv_node_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VLESS / ws"
                android:textColor="@color/gs_primary"
                android:textSize="11sp"
                android:background="@drawable/chip_bg_blue"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gs_outline_variant"
        android:layout_marginStart="68dp"/>

</LinearLayout>
