<?xml version="1.0" encoding="utf-8"?>
<!--
    A large studio widget: the design as one picture (StudioPainter), and three bands over it. The
    header and the numbers open the method; the middle band, where the button is, connects or
    disconnects (StudioPainter.LARGE_TOP / LARGE_BOTTOM = 0.30).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/zone_open"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="30" />

        <FrameLayout
            android:id="@+id/zone_toggle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="40" />

        <FrameLayout
            android:id="@+id/zone_open_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="30" />
    </LinearLayout>
</FrameLayout>
