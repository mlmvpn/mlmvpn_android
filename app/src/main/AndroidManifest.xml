<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- VPN Permission -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE"
        android:required="false" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- In-app update: install the downloaded APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- TV Support Features -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".MlmApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MLMVPNScanner"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|locale|layoutDirection|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VPN Service -->
        <service
            android:name=".MyVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- AmneziaWG (GoBackend) establishes the WireGuard tun through its own internal
             VpnService. It must be declared here or the tunnel comes up but no traffic flows. -->
        <service
            android:name="org.amnezia.awg.backend.AbstractBackend$VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            WireguardScanService: legacy, hosts the old AmneziaWG-based WireGuard pipeline
            that targeted a single UAE endpoint (194.50.233.133). That server is no longer
            reachable from this application, so the service is left declared but unreachable
            from the UI. It can be removed in a future cleanup pass once we're confident no
            edge case still references it.
        -->
        <service
            android:name=".engines.wireguard.WireguardScanService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <!-- tools:targetApi tells both the build tools AND the runtime package-parser
                 that <property> + foregroundServiceType="specialUse" is API-34+. On
                 older devices the entire property element and the FGS-type attribute are
                 skipped cleanly instead of being silently rejected (which produces
                 `ProcessRecord not found` later when ActivityManager tries to start the
                 service). On API 34+ devices the element is parsed normally. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continues the wireguard endpoint scan in the background (legacy)"
                tools:targetApi="34" />
        </service>

        <!--
            AetherScanService: foreground service that drives the Aether Rust binary
            (assets/aether/<abi>/aether), produces a SOCKS5 listener on 127.0.0.1:20810 and
            exposes state through androidx StateFlow's that AetherScreen renders live.
            Replaces WireguardScanService as the primary censorship-circumvention engine.
        -->
        <!--
            IMPORTANT: fully-qualified class path is REQUIRED here.
            The Kotlin class lives at `com.mlmvpn.core.aether.AetherScanService` (no
            "scanner" segment). The app's `namespace = com.mlmvpn.scanner` would
            otherwise prepend `.core.aether.AetherScanService` to a wrong class name
            (`com.mlmvpn.scanner.core.aether.AetherScanService`), and PackageManager
            would happily register it — but ActivityManager would then return
            `not found` every time we try to start it from
            `Intent(context, AetherScanService::class.java)`.
        -->
        <service
            android:name="com.mlmvpn.core.aether.AetherScanService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the Aether engine (MASQUE / WireGuard / WARP-in-WARP) for censorship circumvention"
                tools:targetApi="34" />
        </service>

        <!-- SoftEther SSL-VPN (vendored kittoku.mvc client, Apache-2.0). Brings up its own
             tun through its own VpnService, exactly like AmneziaWG above, so MyVpnService
             deliberately skips setupVpn() on this path. -->
        <service
            android:name="kittoku.mvc.service.SoftEtherVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the SoftEther SSL-VPN tunnel"
                tools:targetApi="34" />
        </service>

        <!--
            Tun2proxyHostService: runs the tun2proxy native core, and NOTHING else, in its own
            process. That core calls exit(255) from native code a few seconds after a normal
            teardown; it cannot be caught or prevented, so it is confined here instead, where its
            death costs nothing. The app's main process keeps its UI, VPN service and engine
            state throughout. See the class doc for the full story.

            android:process is the entire point of this declaration; do not remove it.
        -->
        <service
            android:name=".tun.Tun2proxyHostService"
            android:exported="false"
            android:process=":tun" />

        <!-- Quick Settings tile: one-tap toggle that connects to the fastest recent server. -->
        <service
            android:name=".VpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_vpn"
            android:label="mlmvpn"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- FileProvider: shares the downloaded update APK (in cache dir) with the system
             package installer. Required on API 24+, since raw file:// URIs are blocked. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
